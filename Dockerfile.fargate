# Docker Hubのpullレート制限(429)回避のためECR Publicミラーを使用
FROM public.ecr.aws/docker/library/node:20-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl unzip python3 python3-pip jq ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# AWS CLI v2
RUN curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip \
    && unzip -q /tmp/awscliv2.zip -d /tmp \
    && /tmp/aws/install \
    && rm -rf /tmp/aws /tmp/awscliv2.zip

# Claude Code CLI
RUN npm install -g @anthropic-ai/claude-code

# Python packages (boto3 は 99-send-report.sh 等で利用)
RUN pip3 install boto3 --break-system-packages

# 既存スクリプトのハードコードパスへの互換シムリンク
RUN mkdir -p /home/yuzuki/local/bin && ln -sf /usr/local/bin/aws /home/yuzuki/local/bin/aws

# claude --dangerously-skip-permissions はroot下で拒否されるため非rootで動かす。
# node:20-slim に既存の "node" ユーザ (uid 1000) を使う。
# 自動更新は非rootで失敗し得るので無効化。
ENV DISABLE_AUTOUPDATER=1 \
    HOME=/home/node

WORKDIR /app
COPY . .

RUN chmod +x /app/scripts/fargate-entrypoint.sh \
             /app/scripts/fargate-hook-entrypoint.sh \
             /app/scripts/fargate-report-entrypoint.sh \
             /app/scripts/fargate-ping-entrypoint.sh \
    && chown -R node:node /app /home/node

USER node

ENTRYPOINT ["/app/scripts/fargate-entrypoint.sh"]
